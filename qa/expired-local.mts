/* LOCAL ONLY: expiry cannot be tested on production without waiting 14 days or editing prod data. */
import { chromium } from "@playwright/test";
import { execSync } from "node:child_process";
const BASE = "http://localhost:3000";
const b = await chromium.launch(); const c = await b.newContext({ viewport: { width: 1366, height: 900 } }); const p = await c.newPage();
let reqId = ""; p.on("request", (r) => { const m = r.url().match(/\/api\/requests\/([0-9a-f-]{36})\//); if (m) reqId = m[1]; });
await p.goto(BASE); await p.getByRole("button", { name: "Open demo workspace" }).click(); await p.waitForURL(/dashboard/);
await p.getByLabel("Case / file name").fill("QA expiry (local)"); await p.getByLabel("Client name").fill("Casey Synthetic"); await p.getByLabel("Client email").fill("casey@example.test");
await p.getByRole("button", { name: "Create case" }).click(); await p.waitForURL(/cases/);
await p.locator('input[type="file"]').setInputFiles("qa/artifacts/pdfs/B-harborpine-3p-chromium.pdf");
await p.getByTestId("pdf-page-1").locator("canvas").first().waitFor({ timeout: 60000 });
await p.getByRole("button", { name: /^\+?\s*Signature/ }).click();
const o = p.getByTestId("pdf-page-1").locator("[data-page-overlay]"); const bb = (await o.boundingBox())!; await p.mouse.click(bb.x + bb.width * 0.5, bb.y + 200);
await p.getByTestId("save-state").filter({ hasText: /^Saved$/ }).waitFor();
await p.getByRole("button", { name: "Create signing link" }).click(); const link = await p.getByTestId("signer-url").inputValue();
execSync(`docker exec filesign-pg psql -U postgres -d filesign -c "update signing_requests set expires_at = now() - interval '1 minute' where id = '${reqId}'"`, { stdio: "inherit" });
const s = await (await b.newContext()).newPage(); await s.goto(link); await s.waitForLoadState("networkidle"); await s.waitForTimeout(1000);
console.log("signer sees:", (await s.locator("main").innerText()).replace(/\s+/g, " ").slice(0, 200));
await s.screenshot({ path: "qa/artifacts/adv-expired-link-local.png" });
const sub = await s.evaluate(async (tok) => (await fetch("/api/sign/submit", { method: "POST", headers: { "Content-Type": "application/json", "x-signing-token": tok }, body: JSON.stringify({ consent: true, signerName: "X", method: "drawn", signaturePng: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAAEUlEQVR4nGNgYGD4z8DAwMAAAAgAAQ3cs1YAAAAASUVORK5CYII=" }) })).status, link.split("#")[1]);
console.log("submit on expired link: HTTP", sub);
await p.reload(); console.log("admin status:", await p.getByTestId("status-badge").first().innerText(), "|", (await p.getByTestId("link-panel").innerText().catch(() => "no link panel")).replace(/\s+/g, " ").slice(0, 200));
await p.screenshot({ path: "qa/artifacts/adv-expired-admin-local.png", fullPage: true });
await b.close();
