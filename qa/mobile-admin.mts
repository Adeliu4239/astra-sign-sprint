import { chromium, devices } from "@playwright/test";
const BASE = "https://astra-sign-sprint.vercel.app";
const b = await chromium.launch(); const c = await b.newContext({ ...devices["iPhone 13"] }); await c.addInitScript("globalThis.__name=(f)=>f"); const p = await c.newPage();
await p.goto(BASE); await p.getByRole("button", { name: "Open demo workspace" }).tap(); await p.waitForURL(/dashboard/);
await p.getByLabel("Case / file name").fill("QA mobile admin"); await p.getByLabel("Client name").fill("Casey Synthetic"); await p.getByLabel("Client email").fill("casey@example.test");
await p.getByRole("button", { name: "Create case" }).tap(); await p.waitForURL(/cases/);
await p.locator('input[type="file"]').setInputFiles("qa/artifacts/pdfs/A-northwind-5p-mixed.pdf");
await p.getByTestId("pdf-page-1").locator("canvas").first().waitFor({ timeout: 60000 });
await p.getByRole("button", { name: /^\+?\s*Signature/ }).tap();
const o = p.getByTestId("pdf-page-2").locator("[data-page-overlay]"); await o.scrollIntoViewIfNeeded(); const bb = (await o.boundingBox())!;
await p.touchscreen.tap(bb.x + bb.width * 0.5, bb.y + bb.height * 0.5);
await p.getByTestId("save-state").filter({ hasText: /^Saved$/ }).waitFor({ timeout: 15000 });
console.log("mobile placed:", await p.getByTestId("placed-field").count(), "overflowX:", await p.evaluate(() => document.documentElement.scrollWidth > window.innerWidth));
await p.screenshot({ path: "qa/artifacts/mobile-admin-placed.png" });
await b.close();
