import { chromium } from "@playwright/test";
const BASE = "https://astra-sign-sprint.vercel.app";
const b = await chromium.launch(); const c = await b.newContext({ viewport: { width: 1366, height: 900 } }); const p = await c.newPage();
await p.goto(BASE); await p.getByRole("button", { name: "Open demo workspace" }).click(); await p.waitForURL(/dashboard/);
await p.getByLabel("Case / file name").fill("QA replace"); await p.getByLabel("Client name").fill("Casey Synthetic"); await p.getByLabel("Client email").fill("casey@example.test");
await p.getByRole("button", { name: "Create case" }).click(); await p.waitForURL(/cases/);
await p.locator('input[type="file"]').setInputFiles("qa/artifacts/pdfs/B-harborpine-3p-chromium.pdf");
await p.getByTestId("pdf-page-3").locator("canvas").first().waitFor({ timeout: 60000 });
await p.getByRole("button", { name: /^\+?\s*Signature/ }).click();
const o = p.getByTestId("pdf-page-3").locator("[data-page-overlay]"); await o.scrollIntoViewIfNeeded(); const bb = (await o.boundingBox())!;
await p.mouse.click(bb.x + bb.width * 0.3, bb.y + bb.height * 0.6);
await p.getByTestId("save-state").filter({ hasText: /^Saved$/ }).waitFor();
await p.locator('input[type="file"]').setInputFiles("qa/artifacts/pdfs/big-26mb.pdf");
await p.getByRole("alert").filter({ hasText: /limit/ }).waitFor({ timeout: 10000 });
console.log("replace 26MB error:", await p.getByRole("alert").filter({ hasText: /limit/ }).innerText());
await p.screenshot({ path: "qa/artifacts/adv-oversize-replace.png" });
await p.locator('input[type="file"]').setInputFiles("qa/artifacts/pdfs/ok-owner-restricted.pdf");
await p.waitForFunction(() => document.querySelectorAll('[data-testid^="pdf-page-"]').length === 2, null, { timeout: 60000 });
await p.waitForTimeout(1500);
console.log("after replace with 2-page PDF: pages=", await p.locator('[data-testid^="pdf-page-"]').count(), "placed fields=", await p.getByTestId("placed-field").count());
console.log("sidebar:", (await p.locator("aside").first().innerText().catch(() => "")).replace(/\s+/g, " ").slice(0, 300));
await p.screenshot({ path: "qa/artifacts/adv-replace-after.png" });
await b.close();
