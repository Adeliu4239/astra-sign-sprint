# Postgres connection string. Locally: docker Postgres (see README). On Vercel: injected by the Neon integration.
DATABASE_URL=postgres://postgres:dev@localhost:54329/filesign
# 32+ random bytes, base64/hex. Used to encrypt signer-link tokens at rest so admins can re-copy a pending link.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-random-secret-at-least-32-chars
# Optional: public base URL used when building signer links. Defaults to the request origin.
# PUBLIC_BASE_URL=https://your-app.vercel.app
